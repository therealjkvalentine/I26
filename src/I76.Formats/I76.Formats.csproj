<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>I76.Formats</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Imaging/CarMaterials.tsv" LogicalName="CarMaterials.tsv" />
    <EmbeddedResource Include="Imaging/CarMasks.bin" LogicalName="CarMasks.bin" Condition="Exists('Imaging/CarMasks.bin')" />
    <EmbeddedResource Include="Fsm/mission-script.schema.json" LogicalName="mission-script.schema.json" />
    <EmbeddedResource Include="Remix/Scenarios/*.yaml" LogicalName="remix/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Remix/Nodes/*.yaml" LogicalName="remix-nodes/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Remix/Region/*.yaml" LogicalName="remix-region/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Remix/Voice/lines.json" LogicalName="remix-voice/lines.json" />
    <EmbeddedResource Include="Remix/Voice/places.yaml" LogicalName="remix-voice/places.yaml" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="I76.Formats.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>
</Project>
