<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <!-- A Godot export builds the game as ExportRelease and every library it references with that configuration too. MSBuild optimises
       only a configuration named Release, so without this the libraries (the formats, the simulation, the editor, the network code)
       shipped as unoptimised debug code, several times slower in their tight loops (an export's road layers took most of a big
       map's minute-long build). -->
  <PropertyGroup Condition="'$(Configuration)' == 'ExportRelease'">
    <Optimize>true</Optimize>
  </PropertyGroup>
  <!-- A game run from source (Godot's editor binary pointed at game/: the desktop's launchers, tools/shot.sh, the frame-cost bench) loads
       the Debug build, and Debug code is not optimised: the main thread's tight loops (the bass shaker's synthesis, the drop shadows'
       casters, the smoke, the radar's decode) ran several times slower than a release's, and a frame the processor holds slower with
       them (docs/perf/plan.md, "Debug code and the owner's frame rate"). Optimised here too; `dotnet build -p:Optimize=false` gives
       code a debugger steps through line by line. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Optimize>true</Optimize>
  </PropertyGroup>
</Project>
